import pandas as pd
import requests

# 1. CONFIGURATION DES IDENTIFIANTS DRIVE
# ID extrait du fichier Google Ads Excel
FILE_ID_ADS = '1_8quOdA863-70Q-vOfIRrvC6qe9eGAht'
FILE_ID_FLUX = '1Jc0mMD75DsU44uYy5yHu4BouiOD-9b-2' 


# 2. FONCTION DE TÉLÉCHARGEMENT OPTIMISÉE
def download_drive_file(file_id, output_filename):
    """
    Télécharge un fichier depuis Google Drive en gérant les grands fichiers.
    """
    url = f'https://drive.google.com/uc?id={file_id}&export=download&confirm=t'
    response = requests.get(url)
    
    if response.status_code == 200:
        with open(output_filename, 'wb') as f:
            f.write(response.content)
        print(f"Fichier '{output_filename}' téléchargé avec succès.")
    else:
        print(f"Erreur lors du téléchargement (Code status : {response.status_code})")


# 3. CHARGEMENT DES DONNÉES GOOGLE ADS (.XLSX)
download_drive_file(FILE_ID_ADS, 'ads_data.xlsx')

# Optimisation : 'skiprows=2' ignore le titre du rapport Google Ads pour lire la table directement
try:
    df_ads = pd.read_excel('ads_data.xlsx', skiprows=2)
    # Nettoyage des espaces superflus dans les noms de colonnes
    df_ads.columns = df_ads.columns.str.strip()
    
    print(f"\nAperçu des données Google Ads ({len(df_ads)} lignes) :")
    display(df_ads.head())
except Exception as e:
    print(f"Erreur de lecture Excel (Ajuster 'skiprows' si nécessaire) : {e}")


# 4. CHARGEMENT DU FLUX PRODUITS SHOPPING (.XML)
download_drive_file(FILE_ID_FLUX, 'flux_shopping.xml')

try:
    # Optimisation : parser 'lxml' recommandé pour les flux XML WooCommerce
    df_flux = pd.read_xml('flux_shopping.xml', parser='lxml')
    
    print(f"\n Aperçu du Flux WooCommerce ({len(df_flux)} produits) :")
    display(df_flux.head())
except Exception as e:
    print(f"Erreur de lecture du flux XML : {e}")
